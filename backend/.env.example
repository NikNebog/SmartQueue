DATABASE_URL="postgresql://smartq:smartq@localhost:5432/smartq?schema=public"
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters-long"
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173

# ESC/POS raw ticket files and auto print.
# Raw files are saved even if the printer is unavailable.
TICKET_RAW_ENABLED=true
TICKET_RAW_DIR=uploads/tickets-raw
TICKET_AUTO_PRINT_ENABLED=true
TICKET_PRINT_ORGANIZATION_NAME=SmartQ
TICKET_PRINT_QUEUE_ENABLED=false

# Polling print agent for Windows local spooler.
PRINT_AGENT_TOKEN=

# Windows raw printing from local backend:
# TICKET_PRINTER_SHARE=\\localhost\ReceiptPrinter
#
# Windows shared printer from Docker/Linux backend over SMB:
# TICKET_PRINTER_SHARE=\\host.docker.internal\ReceiptPrinter
# Optional SMB credentials if guest access is disabled:
# TICKET_PRINTER_SMB_USERNAME=printuser
# TICKET_PRINTER_SMB_PASSWORD=secret
# TICKET_PRINTER_SMB_DOMAIN=WORKGROUP
TICKET_PRINTER_SHARE=
TICKET_PRINTER_SMB_USERNAME=
TICKET_PRINTER_SMB_PASSWORD=
TICKET_PRINTER_SMB_DOMAIN=

# Linux/CUPS raw printing:
# TICKET_PRINTER_NAME=ReceiptPrinter
TICKET_PRINTER_NAME=

# Direct USB/device raw printing, mostly for Linux containers with mapped devices:
# TICKET_PRINTER_DEVICE_PATH=/dev/usb/lp0
TICKET_PRINTER_DEVICE_PATH=
